  settings: {fileID: 11400000, guid: de0fc1e51d56d564ca25801d6ea69f57, type: 2}
  routine: {fileID: 11400000, guid: 333c9fbe646c3074ab802d04d531996f, type: 2}
  content: {fileID: 316299702}
  sceneCamera: {fileID: 2008693164}
  lanes: {fileID: 832311866}
  formation: {fileID: 40095839}
  jury: {fileID: 1245421808}
  effects: {fileID: 1608754122}
  hud: {fileID: 814839131}
  music: {fileID: 439891062}
  visibleSize: {x: 30, y: 16.875}
  laneId:
  - elemental
  - nebulosa
  - druida
  - rayo
  laneName:
  - Mago Elemental
  - Maga Nebulosa
  - Druida Verde
  - Mago del Rayo
  testName: "Nataci\xF3n art\xEDstica"
  medals:
  - {fileID: 8144175315403573127, guid: 9ce6e3a6ad1ff3d4392256eb8746097f, type: 3}
  - {fileID: 1504388026, guid: 9ce6e3a6ad1ff3d4392256eb8746097f, type: 3}
  - {fileID: 913215149, guid: 9ce6e3a6ad1ff3d4392256eb8746097f, type: 3}
  finalScene: 99_CeremoniaFinal
  intro:
  - "\xA1Bienvenidos a la Piscina de la Luna! La \xFAltima prueba de las Magolimpiadas
    es la nataci\xF3n art\xEDstica: los cuatro nadan juntos una rutina de cuatro
    figuras."
  - "Cada mago tiene un carril de notas de su color. T\xFA eres {mago}: pulsa Espacio
    (o clic) justo cuando una nota de tu color cruce la l\xEDnea dorada."
  - "Las notas blancas son de los cuatro: solo cuentan si todos aciertan a la vez.
    Las doradas dan puntos extra. Y las rojas con una X son trampas: \xA1no las toques!"
  - "Siete b\xFAhos jueces califican cada figura. Si una figura sale mal, se repite.
    Con la nota final ganan oro, plata o bronce. \xA1Al agua!"
  introOnlyFirstTime: 1
  playSolo: 0
