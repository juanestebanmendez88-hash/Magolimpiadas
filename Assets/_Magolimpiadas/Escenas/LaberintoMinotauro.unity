  m_IsActive: 1
--- !u!114 &1794506031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1794506030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a20c7d443204b014c9558df7fa3377dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LabyrinthIntro
  guide: {fileID: 1873472380}
  sceneCamera: {fileID: 262675457}
  onBegin: 1
  skipKey: 60
  smoothing: 0.6
  viewDistance: 85
  avoidWalls: 1
  steps:
  - text: "\xA1Hola, {mago}! Para comenzar, lleva la llama ol\xEDmpica a trav\xE9s
      del laberinto hasta el pebetero de la isla."
    target: {fileID: 0}
    isPlayer: 1
    distance: 2.6
    height: 0.7
    gazeHeight: 1.3
    fromFront: 1
    rotation: 20
    highlight: 2
    cameraPoint: {fileID: 0}
  - text: "Este portal te llevar\xE1 a la isla, pero todav\xEDa est\xE1 dormido:
      primero tendr\xE1s que activarlo."
    target: {fileID: 1500480960}
    isPlayer: 0
    distance: 7
    height: 3.5
    gazeHeight: 2.47
    fromFront: 0
    rotation: 0
    highlight: 1
    cameraPoint: {fileID: 439961180}
  - text: "Busca el interruptor: est\xE1 en la zona de las islas flotantes y las
      p\xFAas. Al tocarlo, el portal despertar\xE1."
    target: {fileID: 155070242}
    isPlayer: 0
    distance: 9
    height: 7
    gazeHeight: 0.8
    fromFront: 0
    rotation: 0
    highlight: 1
    cameraPoint: {fileID: 197565968}
  - text: "Pero ten cuidado: el minotauro vigila el laberinto y no dejar\xE1 que
      pases as\xED como as\xED."
    target: {fileID: 2109171427}
    isPlayer: 0
    distance: 4.5
    height: 2.2
    gazeHeight: 1.6
    fromFront: 1
    rotation: 0
    highlight: 1
    cameraPoint: {fileID: 0}
  - text: "En algunos rincones brilla un hechizo de runas: es una zona segura. Mientras
      est\xE9s dentro, el minotauro no podr\xE1 verte."
    target: {fileID: 1654314699}
    isPlayer: 0
    distance: 6
    height: 5
    gazeHeight: 1.5
    fromFront: 0
    rotation: 0
    highlight: 1
    cameraPoint: {fileID: 625648822}
  - text: "Y no est\xE1s solo: las plataformas de teletransporte te llevar\xE1n,
      al azar, a otra parte del laberinto."
    target: {fileID: 757359694}
    isPlayer: 0
    distance: 5
    height: 5
    gazeHeight: 0.5
    fromFront: 0
    rotation: 0
    highlight: 1
    cameraPoint: {fileID: 1439252967}
  - text: "\xA1Buena suerte, {mago}!"
    target: {fileID: 0}
    isPlayer: 1
    distance: 3
    height: 0.9
    gazeHeight: 1.2
    fromFront: 1
    rotation: -15
    highlight: 0
    cameraPoint: {fileID: 0}
